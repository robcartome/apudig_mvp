  "components": {
    "schemas": {
      "CommercialProfile": {
        "type": "object",
        "properties": {
          "context": {
            "type": "string",
            "default": "commercial"
          },
          "websiteId": {
            "type": "string",
            "format": "uuid"
          },
          "accountId": {
            "type": "string",
            "format": "uuid",
            "description": "Own account identifier for isolated cart storage; never an authorization input."
          },
          "company": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "user": {
            "$ref": "#/components/schemas/CommercialUser"
          },
          "contactVerified": {
            "type": "boolean"
          },
          "verificationChannel": {
            "$ref": "#/components/schemas/VerificationChannelEnum"
          },
          "wholesaleApproved": {
            "type": "boolean"
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          }
        },
        "required": [
          "accountId",
          "capabilities",
          "company",
          "contactVerified",
          "user",
          "verificationChannel",
          "websiteId",
          "wholesaleApproved"
        ]
      },
      "CommercialUser": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "name"
        ]
      },
      "VerificationChannelEnum": {
        "enum": [
          "email"
        ],
        "type": "string",
        "description": "* `email` - email"
      },
      "CartConfirmation": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {}
            },
            "maxItems": 200,
            "minItems": 1
          },
          "offerFingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "items",
          "offerFingerprint"
        ]
      },
      "CartReview": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {}
            },
            "maxItems": 200,
            "minItems": 1
          }
        },
        "required": [
          "items"
        ]
      },
      "OrderPreparation": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {}
            },
            "maxItems": 200,
            "minItems": 1
          },
          "offerFingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "note": {
            "type": "string",
            "default": "",
            "maxLength": 500
          },
          "shareConfirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "items",
          "offerFingerprint",
          "shareConfirmed"
        ]
      },
      "AccountConsent": {
        "type": "object",
        "properties": {
          "noticeVersion": {
            "type": "string",
            "maxLength": 40
          },
          "accepted": {
            "type": "boolean"
          }
        },
        "required": [
          "accepted",
          "noticeVersion"
        ]
      },
      "CommercialToken": {
        "type": "object",
        "properties": {
          "context": {
            "type": "string",
            "default": "commercial",
            "description": "Always commercial; does not grant ERP access."
          },
          "websiteId": {
            "type": "string",
            "format": "uuid"
          },
          "access": {
            "type": "string"
          },
          "access_token": {
            "type": "string"
          },
          "refresh": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          }
        },
        "required": [
          "access",
          "access_token",
          "websiteId"
        ]
      },
      "RegistrationStart": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "name": {
            "type": "string",
            "default": "",
            "maxLength": 150
          },
          "noticeVersion": {
            "type": "string",
            "maxLength": 40
          },
          "consent": {
            "type": "boolean"
          },
          "purpose": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PurposeEnum"
              }
            ],
            "default": "REGISTER"
          }
        },
        "required": [
          "consent",
          "email",
          "noticeVersion"
        ]
      },
      "PurposeEnum": {
        "enum": [
          "REGISTER",
          "RECOVERY"
        ],
        "type": "string",
        "description": "* `REGISTER` - REGISTER\n* `RECOVERY` - RECOVERY"
      },
      "RegistrationComplete": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "default": "",
            "maxLength": 200
          },
          "purpose": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PurposeEnum"
              }
            ],
            "default": "REGISTER"
          }
        },
        "required": [
          "token"
        ]
      },
      "AdministrativeAccountsPage": {
        "type": "object",
        "properties": {
          "websiteId": {
            "type": "string",
            "format": "uuid"
          },
          "count": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdministrativeAccount"
            }
          }
        },
        "required": [
          "count",
          "limit",
          "offset",
          "results",
          "websiteId"
        ]
      },
      "AdministrativeAccount": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "etag": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/CommercialUser"
          },
          "customer": {
            "type": "object",
            "additionalProperties": {}
          },
          "contactVerified": {
            "type": "boolean"
          },
          "wholesaleApproved": {
            "type": "boolean"
          },
          "priceList": {
            "type": "object",
            "additionalProperties": {},
            "nullable": true
          }
        },
        "required": [
          "contactVerified",
          "customer",
          "etag",
          "id",
          "priceList",
          "status",
          "user",
          "wholesaleApproved"
        ]
      },
      "PatchedWholesaleApproval": {
        "type": "object",
        "properties": {
          "wholesaleApproved": {
            "type": "boolean"
          }
        }
      },
      "Notice": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "maxLength": 40
          },
          "text": {
            "type": "string",
            "maxLength": 15000
          },
          "pendingRetentionDays": {
            "type": "integer",
            "maximum": 36500,
            "minimum": 1
          },
          "linkingMode": {
            "$ref": "#/components/schemas/LinkingModeEnum"
          }
        },
        "required": [
          "linkingMode",
          "pendingRetentionDays",
          "text",
          "version"
        ]
      },
      "LinkingModeEnum": {
        "enum": [
          "REVIEW_ALL",
          "NEW_OR_REVIEW"
        ],
        "type": "string",
        "description": "* `REVIEW_ALL` - REVIEW_ALL\n* `NEW_OR_REVIEW` - NEW_OR_REVIEW"
      },
      "RegistrationReview": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "customerId"
        ]
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "CatalogBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "CommercialBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Commercial purpose; current account/session authorization required."
      },
      "ContextIdentityBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Commercial purpose; current account/session authorization required."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid"
      }
    }
  }
}