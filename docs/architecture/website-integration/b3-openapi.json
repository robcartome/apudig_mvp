  "components": {
    "schemas": {
      "CurrentWebsite": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "companyId": {
            "type": "string",
            "format": "uuid"
          },
          "templateKey": {
            "type": "string"
          },
          "documentSchemaVersion": {
            "type": "integer"
          },
          "revision": {
            "type": "integer"
          },
          "capabilities": {
            "$ref": "#/components/schemas/WebsiteCapabilities"
          }
        },
        "required": [
          "capabilities",
          "companyId",
          "documentSchemaVersion",
          "id",
          "revision",
          "templateKey"
        ]
      },
      "EditorRecord": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "integer"
          },
          "companyId": {
            "type": "string",
            "format": "uuid"
          },
          "websiteId": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer"
          },
          "draft": {},
          "published": {
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {}
            }
          },
          "capabilities": {
            "$ref": "#/components/schemas/WebsiteCapabilities"
          }
        },
        "required": [
          "capabilities",
          "companyId",
          "draft",
          "events",
          "published",
          "publishedAt",
          "revision",
          "schemaVersion",
          "updatedAt",
          "websiteId"
        ]
      },
      "KindEnum": {
        "enum": [
          "IMAGE",
          "LOGO",
          "FAVICON",
          "BANNER",
          "PROMOTION",
          "SECTION"
        ],
        "type": "string",
        "description": "* `IMAGE` - IMAGE\n* `LOGO` - LOGO\n* `FAVICON` - FAVICON\n* `BANNER` - BANNER\n* `PROMOTION` - PROMOTION\n* `SECTION` - SECTION"
      },
      "MediaPage": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WebsiteMedia"
            }
          }
        },
        "required": [
          "count",
          "results"
        ]
      },
      "PublicWebsiteContent": {
        "type": "object",
        "properties": {
          "websiteId": {
            "type": "string",
            "format": "uuid"
          },
          "hostname": {
            "type": "string"
          },
          "canonicalHostname": {
            "type": "string"
          },
          "templateKey": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "commerceEnabled": {
            "type": "boolean"
          },
          "content": {}
        },
        "required": [
          "canonicalHostname",
          "commerceEnabled",
          "content",
          "currency",
          "hostname",
          "locale",
          "publishedAt",
          "revision",
          "templateKey",
          "websiteId"
        ]
      },
      "PublicWebsiteContext": {
        "type": "object",
        "properties": {
          "websiteId": {
            "type": "string",
            "format": "uuid"
          },
          "hostname": {
            "type": "string"
          },
          "canonicalHostname": {
            "type": "string"
          },
          "templateKey": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          }
        },
        "required": [
          "canonicalHostname",
          "currency",
          "hostname",
          "locale",
          "revision",
          "templateKey",
          "websiteId"
        ]
      },
      "RestoreRevision": {
        "type": "object",
        "properties": {
          "revisionId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "revisionId"
        ]
      },
      "RevisionSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer"
          },
          "editorialRevision": {
            "type": "integer",
            "nullable": true
          },
          "operation": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "object",
            "additionalProperties": {},
            "nullable": true
          },
          "sourceRevisionId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": [
          "actor",
          "at",
          "editorialRevision",
          "id",
          "operation",
          "sourceRevisionId",
          "version"
        ]
      },
      "RevisionsPage": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RevisionSummary"
            }
          }
        },
        "required": [
          "count",
          "results"
        ]
      },
      "SaveDraft": {
        "type": "object",
        "properties": {
          "document": {},
          "mediaReferences": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "document"
        ]
      },
      "UploadMedia": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "allOf": [
              {
                "$ref": "#/components/schemas/KindEnum"
              }
            ],
            "default": "IMAGE"
          },
          "altText": {
            "type": "string",
            "default": "",
            "maxLength": 180
          }
        },
        "required": [
          "file"
        ]
      },
      "WebsiteCapabilities": {
        "type": "object",
        "properties": {
          "view": {
            "type": "boolean"
          },
          "edit": {
            "type": "boolean"
          },
          "publish": {
            "type": "boolean"
          },
          "mediaUpload": {
            "type": "boolean"
          },
          "domains": {
            "type": "boolean"
          },
          "realPublication": {
            "type": "boolean"
          }
        },
        "required": [
          "domains",
          "edit",
          "mediaUpload",
          "publish",
          "realPublication",
          "view"
        ]
      },
      "WebsiteMedia": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "websiteId": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string"
          },
          "thumbnailUrl": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "altText": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        },
        "required": [
          "altText",
          "height",
          "id",
          "kind",
          "mimeType",
          "size",
          "thumbnailUrl",
          "url",
          "websiteId",
          "width"
        ]
      },
      "WebsitePreview": {
        "type": "object",
        "properties": {
          "websiteId": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer"
          },
          "content": {}
        },
        "required": [
          "content",
          "revision",
          "websiteId"
        ]
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}