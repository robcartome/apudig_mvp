    "/api/v1/websites/{website_id}/draft/": {
      "put": {
        "operationId": "websites_draft_update",
        "parameters": [
          {
            "in": "header",
            "name": "If-Match",
            "schema": {
              "type": "string"
            },
            "description": "Strong ETag of the entire website, for example \"4\".",
            "required": true
          },
          {
            "in": "path",
            "name": "website_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
