DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite by default
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=db.sqlite3

# Uncomment for PostgreSQL
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=apudig_mvp
# DJANGO_DB_USER=postgres
# DJANGO_DB_PASSWORD=admin
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=5432

# Cloudflare R2 (product images)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://media.apudig.com
# Optional image-processing limits
PRODUCT_IMAGE_MAX_SIZE=5242880
PRODUCT_IMAGE_MAX_DIMENSION=1200
PRODUCT_IMAGE_WEBP_QUALITY=82
# DJANGO_DB_PORT=5432
