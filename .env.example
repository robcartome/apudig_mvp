DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Incrementar en cada despliegue que cambie los recursos estaticos del POS.
POS_STATIC_VERSION=20261106-6
# Django session used by web and installed POS PWA (14 days by default)
DJANGO_SESSION_COOKIE_AGE=1209600
# Production HTTPS defaults to secure cookies when DJANGO_DEBUG=0.
# DJANGO_SESSION_COOKIE_SECURE=1
# DJANGO_CSRF_COOKIE_SECURE=1

# SQLite by default
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=db.sqlite3

# Uncomment for PostgreSQL
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=apudig_mvp
# DJANGO_DB_USER=postgres
# DJANGO_DB_PASSWORD=admin
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=5432

# Cloudflare R2 (product images)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://media.apudig.com
# Optional image-processing limits
PRODUCT_IMAGE_MAX_SIZE=5242880
PRODUCT_IMAGE_MAX_DIMENSION=1920
PRODUCT_IMAGE_MAX_SOURCE_DIMENSION=12000
PRODUCT_IMAGE_MAX_PIXELS=40000000
PRODUCT_IMAGE_WEBP_QUALITY=82
PRODUCT_IMAGE_THUMBNAIL_DIMENSION=480
PRODUCT_IMAGE_THUMBNAIL_QUALITY=78
TREASURY_ATTACHMENT_MAX_SIZE=5242880
# DJANGO_DB_PORT=5432
# Website B1: registry policy; these values do not publish or verify domains.
WEBSITE_PLATFORM_DOMAIN=apudig.com
WEBSITE_RESERVED_SUBDOMAINS=www,web,admin,api,media,status
WEBSITE_DEV_HOSTNAME=tienda.localhost

# Commercial registration stays closed until privacy, provider and real delivery
# have been accepted. Never use a console/locmem backend as real verification.
WEBSITE_REGISTRATION_ENABLED=0
# Shared PostgreSQL hourly budgets; no raw IP/email in counters. Fixed windows.
WEBSITE_REGISTRATION_IP_LIMIT=20
WEBSITE_REGISTRATION_EMAIL_LIMIT=3
WEBSITE_REGISTRATION_DOMAIN_LIMIT=200
WEBSITE_REGISTRATION_GLOBAL_LIMIT=1000
# Empty: ignore X-Forwarded-For. Set only actual reverse-proxy CIDRs.
WEBSITE_TRUSTED_PROXY_CIDRS=
WEBSITE_EMAIL_BACKEND=disabled
WEBSITE_EMAIL_FROM=
WEBSITE_SMTP_HOST=
WEBSITE_SMTP_PORT=587
WEBSITE_SMTP_USER=
WEBSITE_SMTP_PASSWORD=
WEBSITE_SMTP_USE_TLS=1
WEBSITE_SMTP_USE_SSL=0
# Optional origin for real local delivery tests; only DEBUG + matching *.localhost.
# Ignored in production and for real domains. No path/query/credentials allowed.
WEBSITE_EMAIL_DEV_ORIGIN=
